# URL del backend. En producción: https://api.tudominio.com (se fija al hacer el build de Vite).
VITE_API_URL=http://localhost:3000

# Opcionales. Origen público del sitio para el enlace directo de los cursos (por defecto, el origen actual del navegador).
VITE_PUBLIC_APP_URL=
# Opcional. ID numérico de la página de empresa en LinkedIn para el botón «Añadir a LinkedIn» de las constancias.
VITE_LINKEDIN_ORGANIZATION_ID=

# Cloudinary se configura exclusivamente en ../back-stream/.env.
# No agregues API keys, secrets ni CLOUDINARY_URL al frontend.
